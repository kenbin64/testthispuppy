<?xml version="1.0" encoding="UTF-8"?>
<!-- TestThisPuppy: real-database testing over HTTP and the browser, leaving no trace.
     Two modules: demo-app (a small Spring Boot app to test against) and puppy (the tester). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.testthispuppy</groupId>
  <artifactId>testthispuppy-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <modules>
    <module>demo-app</module>
    <module>puppy</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- Mutation testing: tests the TESTS. PIT plants small bugs in the code (flips a comparison, drops a call,
       changes a return value) and reruns the tests; a planted bug the tests do not catch is a gap in the tests.
       TestThisPuppy runs it for you (mutation.* settings), or by hand:
         mvn -pl puppy test-compile org.pitest:pitest-maven:mutationCoverage -DexcludedTestClasses=com.testthispuppy.FailurePathsTest
       The report lands in <module>/target/pit-reports/. Settings come from the command line, so none are fixed here. -->
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.pitest</groupId>
          <artifactId>pitest-maven</artifactId>
          <version>1.30.1</version>
          <dependencies>
            <dependency>
              <groupId>org.pitest</groupId>
              <artifactId>pitest-junit5-plugin</artifactId>
              <version>1.2.3</version>
            </dependency>
          </dependencies>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
