<?xml version="1.0" encoding="UTF-8"?>
<!-- TestThisPuppy: real-database testing over HTTP and the browser, leaving no trace.
     Two modules: demo-app (a small Spring Boot app to test against) and puppy (the tester). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.testthispuppy</groupId>
  <artifactId>testthispuppy-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <modules>
    <module>demo-app</module>
    <module>puppy</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
</project>
